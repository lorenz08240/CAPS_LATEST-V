# Database Connection Configuration
# If connecting locally:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=buildlab_db

# If connecting to a shared/remote database:
# DB_HOST=your-shared-host-or-ip
# DB_PORT=3306
# DB_USER=your_shared_user
# DB_PASSWORD=your_shared_password
# DB_NAME=buildlab_db

# Email delivery for first-sign-in security PINs
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=your 16-character Google App Password (not your login password).
# Without SMTP_HOST the server logs the PIN to its console for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave MAIL_FROM blank to send from SMTP_USER (most reliable with Gmail).
MAIL_FROM=
